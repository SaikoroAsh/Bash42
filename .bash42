##### V1 to V2 MIGRATION #####

unalias b42 2>/dev/null

b42()
{
    # supprimer du bashrc
    curl -LO https://github.com/SaikoroAsh/Bash42/releases/latest/download/Bash42.zip \
        && unzip Bash42.zip -d ~ \
        && rm Bash42.zip \
        && rm -f ~/.bash42 \
        && echo ". ~/.Bash42/bash42.sh" >> ~/.bashrc \
        && sed '/\. ~\/\.bash42/d' ~/.bashrc > ~/.bashtmp && mv ~/.bashtmp ~/.bashrc \
        && source ~/.bashrc \
        && help42 \
        || echo "There was an error trying to update!"
}
